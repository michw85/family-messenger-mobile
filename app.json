{
  "expo": {
    "owner": "mvorontsovs-team",
    "name": "Bonds",
    "slug": "family-messenger-mobile",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mvorontsov.bonds",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "package": "com.mvorontsov.bonds",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2C3E7A"
      },
      "versionCode": 7,
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#6C5CE7"
        }
      ],
      "expo-audio",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Разрешите доступ к микрофону для распознавания речи в голосовых сообщениях",
          "speechRecognitionPermission": "Разрешите распознавание речи для транскрипции голосовых сообщений"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "Разрешите доступ к галерее, чтобы сохранять фото и видео из чатов",
          "savePhotosPermission": "Разрешите сохранять фото и видео из чатов в галерею",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "./plugins/withAndroidBuildStagingDir"
    ],
    "extra": {
      "eas": {
        "projectId": "cd3777d1-9f36-4fe9-b724-7dcb24a59bf5"
      }
    }
  }
}
